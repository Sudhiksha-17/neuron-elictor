# results: track small text artifacts only (all verified < 5 MB); large binaries excluded below
results/**
!results/**/
!results/**/*.json
!results/**/*.jsonl
!results/**/*.md
!results/**/*.csv
# model / dataset cache
hf_cache/
# logs are tracked (all < 5 MB); runtime pid files are not useful
logs/*.pid
logs/*.pid.watcher
# pip and other caches
.cache/
__pycache__/
*.pyc
.ipynb_checkpoints/
# secrets / tool state
.ssh_keys/
.claude/
.env
*token*
# archives / large files
*.tar.gz
*.pt
*.npz
*.safetensors
